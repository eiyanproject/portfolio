---
// Standalone pages from the `pages` collection (About, Contact, ...).
// getStaticPaths only emits routes for entries that exist, so this does not
// swallow /projects/ or /writing/.
import { getCollection, render } from 'astro:content';
import { showDrafts } from '../lib/drafts';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => showDrafts || !data.draft);

  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} — Afif`} description={entry.data.description}>
  <article>
    <h1>{entry.data.title}</h1>
    {entry.data.draft && <p class="meta">draft</p>}
    <div class="prose"><Content /></div>
  </article>
</Base>
