---
import { getCollection } from 'astro:content';
import { showDrafts } from '../lib/drafts';
import Base from '../layouts/Base.astro';


const projects = (await getCollection('projects', ({ data }) => showDrafts || !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featured = projects.filter((p) => p.data.featured);
const shown = (featured.length > 0 ? featured : projects).slice(0, 4);
---

<Base
  title="Afif — Portfolio"
  description="Portfolio of Afif — infrastructure, homelab, and software projects."
>
  <h1>Afif</h1>
  <p class="lede">Portfolio in progress.</p>

  <h2>Projects</h2>
  {
    shown.length === 0 ? (
      <p class="empty">Nothing published yet.</p>
    ) : (
      <ul class="card-list">
        {shown.map((project) => (
          <li class="card">
            <h3>
              <a href={`/projects/${project.id}/`}>{project.data.title}</a>
            </h3>
            <p>{project.data.summary}</p>
          </li>
        ))}
      </ul>
    )
  }

  {projects.length > shown.length && <p><a href="/projects/">All projects &rarr;</a></p>}
</Base>
