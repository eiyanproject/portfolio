---
import { settings } from '../lib/settings';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" style={`--accent: ${settings.accent}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description ?? settings.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand">{settings.siteName}</a>
      <nav>
        {
          settings.nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <p>{settings.footer || `© ${year} ${settings.siteName}`}</p>
      {
        settings.links && settings.links.length > 0 && (
          <ul class="footer-links">
            {settings.links.map((link) => (
              <li>
                <a href={link.url} rel="me noopener">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0d1117;
    --surface: #161b22;
    --border: #30363d;
    --text: #c9d1d9;
    --muted: #8b949e;
    --accent: #58a6ff;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --measure: 46rem;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
  }

  .site-header,
  .site-footer,
  main {
    width: 100%;
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .site-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 2rem 3rem;
  }

  .brand {
    color: var(--text);
    font-weight: 600;
    font-size: 1.125rem;
  }

  .site-header nav {
    display: flex;
    gap: 1.25rem;
  }
  .site-header nav a {
    color: var(--muted);
  }
  .site-header nav a[aria-current='page'] {
    color: var(--text);
  }

  main {
    flex: 1;
    padding-bottom: 4rem;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 1.5rem;
    color: var(--muted);
    font-size: 0.875rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .site-footer p {
    margin: 0;
  }
  .footer-links {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }
  h2 {
    font-size: 1.25rem;
    margin: 2.5rem 0 1rem;
  }

  .lede {
    color: var(--muted);
    font-size: 1.0625rem;
    margin-top: 0;
  }

  .meta {
    color: var(--muted);
    font-size: 0.8125rem;
    font-family: var(--mono);
  }

  .empty {
    color: var(--muted);
    border: 1px dashed var(--border);
    border-radius: 8px;
    padding: 2rem;
    text-align: center;
  }

  .card-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    background: var(--surface);
  }
  .card h3 {
    margin: 0 0 0.25rem;
    font-size: 1.0625rem;
  }
  .card p {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
  }
  .tags li {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.125rem 0.5rem;
  }

  .prose :is(h2, h3) {
    margin-top: 2rem;
  }
  .prose pre {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    overflow-x: auto;
  }
  .prose code {
    font-family: var(--mono);
    font-size: 0.9em;
  }
  .prose blockquote {
    margin-inline: 0;
    padding-left: 1rem;
    border-left: 3px solid var(--border);
    color: var(--muted);
  }
</style>
